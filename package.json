{
  "name": "@pi/agent-role",
  "version": "0.1.0",
  "description": "通用角色 Agent 运行时（库依赖库形态，构建于 @pi/agent-mesh 之上）",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:imports": "node scripts/check-imports.mjs"
  },
  "dependencies": {
    "@pi/agent-mesh": "file:../pi-agent-mesh",
    "better-sqlite3": "^13.0.3",
    "confbox": "^0.1.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@earendil-works/pi-durable": "^1.5.0",
    "@earendil-works/pi-schema": "^1.5.0",
    "@earendil-works/chord": "^1.5.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    },
    "@earendil-works/pi-schema": {
      "optional": true
    },
    "@earendil-works/chord": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@earendil-works/chord": "1.5.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}